# Settings for the docker/ test stack. Copy to docker/.env, or let
# `docker/fa-sgw-sales init` write one with ports that are free on this machine.
#
# Every value here is a default that docker/fa-sgw-sales already applies — this
# file exists to show what can be changed, not because anything must be.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Containers and the database volume are named after this. It defaults to
# fa-sgw-sales-<checkout directory name>, which is what keeps a worktree's stack
# separate from the main checkout's.
#COMPOSE_PROJECT_NAME=fa-sgw-sales-sgw_sales

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------

# Clear of the FrontAccounting stack (8080/3307/8081), the modules/api stack
# (8090/3309/8091), the Anorm stacks (3316-3319, 8096-8099) and the
# modules/graphql stack (8100/3320/8101), so all of them can run at once. Inside
# the container Apache is always on 8000.
#HTTP_PORT=8110
#DB_PORT=3330
#PMA_PORT=8111

# ---------------------------------------------------------------------------
# FrontAccounting
# ---------------------------------------------------------------------------

# The application this module plugs into, cloned into the image at build time.
# The default is the fork production runs, which sales_order_entry.php here was
# patched from. Point it upstream to see how far that has moved:
#
#   FA_REPO=https://github.com/FrontAccountingERP/FA.git
#   FA_REF=master
#
# A shallow clone needs a branch or a tag; a bare commit sha will not work.
# Changing either needs `docker/fa-sgw-sales up --build`.
#FA_REPO=https://github.com/cambell-prince/frontaccounting.git
#FA_REF=master-cp

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

# Any version sury publishes for Debian trixie: 7.4, 8.0 ... 8.4. 7.4 is the
# floor Anorm 3 supports, the platform composer.json resolves the lock against,
# and the newest FrontAccounting 2.4.x is known to run on.
#PHP_VERSION=7.4

#MARIADB_VERSION=10.11

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The entrypoint writes these into FrontAccounting's config_db.php on every
# start.
#DB_NAME=fa_sgw_sales
#DB_USER=fa
#DB_PASSWORD=fa
#DB_ROOT_PASSWORD=fa

# The table prefix. Datasets ship with 0_ baked in; anything else is rewritten
# as it loads.
#DB_PREFIX=0_

# What `fa-sgw-sales up` loads into an empty database, and the default for
# `fa-sgw-sales db reset`: demo or new — FrontAccounting's own installer
# datasets, login admin / password — or test / test-demo, this module's old
# fixtures. The module's sales_recurring table is loaded on top of any of them.
#SEED=demo

# ---------------------------------------------------------------------------
# PHP
# ---------------------------------------------------------------------------

# Leave xdebug off unless you are attaching to it — it costs real time on every
# request. "debug" enables step debugging on port 9003, triggered by
# XDEBUG_TRIGGER; "coverage" is what phpunit --coverage-html needs.
#
# docker/fa-sgw-sales folds "develop" into whatever you set, because FA calls
# xdebug_call_file() and xdebug 3 only provides it in that mode.
#XDEBUG_MODE=off

# The extension is compiled in unless this is false at build time.
#INSTALL_XDEBUG=true

#FA_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Host user
# ---------------------------------------------------------------------------

# Apache and composer run as www-data remapped to these, so vendor/ and anything
# else written into the bind-mounted checkout stays yours. docker/fa-sgw-sales
# fills them in from `id -u`/`id -g`.
#USER_UID=1000
#USER_GID=1000
