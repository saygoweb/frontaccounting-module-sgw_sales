<?xml version="1.0"?>
<ruleset name="FrontAccounting sgw_sales">
    <description>Coding standard for the sgw_sales module.</description>

    <rule ref="PSR12"/>

    <!-- The namespaced classes and the tests. The pages at the root, view/,
         inquiry/ and includes/ui are FrontAccounting-style code - procedural,
         tab-indented, sales_order_entry.php a patched copy of FA's own - and
         measuring them against PSR-12 produces violations nobody intends to
         fix. php -l covers them (composer lint). -->
    <file>includes/common</file>
    <file>includes/controller</file>
    <file>includes/db</file>
    <file>tests</file>

    <!-- FrontAccounting's own fixture config, copied from FA and formatted like
         FA. Not ours to restyle. -->
    <exclude-pattern>tests/data/*</exclude-pattern>

    <!-- The namespaces are lower case (SGW_Sales\db) and PSR-4 maps them to
         directories, so renaming them is a breaking change, not a style fix. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>

    <exclude-pattern>vendor/*</exclude-pattern>

    <!-- Progress, colours, and sniff codes in the report so a violation can be
         looked up or excluded by name. -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg value="s"/>
</ruleset>
